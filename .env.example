# Frontend
VITE_ALUMNOS_JSON_URL=
# Optional. Defaults to /.netlify/functions/chatbot
VITE_CHATBOT_API_URL=

# AI provider used by Keyla: groq | gemini | openai | claude
AI_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
