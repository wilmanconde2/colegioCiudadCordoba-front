{
  "name": "-colegiocc",
  "private": true,
  "version": "1.6.6",
  "type": "module",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run prerender:metadata && npm run verify:route-metadata",
    "lint": "eslint .",
    "test": "npm run test:serverless && npm run test:ui",
    "test:e2e": "playwright test",
    "test:serverless": "node --test netlify/functions/_chatbot/*.test.js",
    "test:ui": "vitest run --passWithNoTests",
    "coverage:ui": "vitest run --coverage",
    "prerender:metadata": "node scripts/prerender-route-metadata.mjs",
    "verify:route-metadata": "node scripts/verify-route-metadata.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.5.0",
    "react-router": "^8.3.0",
    "react-spinners": "^0.17.0",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
